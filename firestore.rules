rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    // Each identity can reach only its own namespace. The legacy /copies tree deliberately has no
    // match and is therefore closed after the administrator migration.
    match /users/{uid}/copies/{document=**} {
      allow read, write: if isGoogleOwner(uid);
    }
  }
}
