# Every environment variable this project reads. All of them are optional: with none set, the app
# builds, deploys and runs — the league story falls back to the deterministic generator and the
# GameChanger proxy talks to the public API with no extra headers.
#
# Copy to `functions/.env.<project-id>` for a Firebase deploy, or use GitHub Actions secrets
# GEMINI_API_KEY/GROQ_API_KEY and variables GEMINI_MODEL/GROQ_MODEL. `.env` is
# gitignored; this file is the only one committed, and it must never carry a real value.
#
# NEVER prefix any of these with `VITE_`. That prefix inlines a value into the client bundle, which
# for a key means publishing it. These are read only by the two serverless functions, server-side.

# --- server/league-summary.ts --------------------------------------------------------------------

# Google Gemini key. Unset, the AI league story and forecast write-up are simply not offered and
# the deterministic story is used instead — which is also the fallback whenever a call fails.
GEMINI_API_KEY=

# Pin a specific Gemini model, e.g. `gemini-2.5-flash`. Unset, the function asks the key which
# models it can use and ranks them newest-generation-first, which is usually what you want.
GEMINI_MODEL=

# Optional Groq fallback key and model, also server-side only.
GROQ_API_KEY=
GROQ_MODEL=

# --- server/gc-team.ts ---------------------------------------------------------------------------

# Override the GameChanger API base. Unset, the public one is used. Mostly for pointing the pull at
# a recorded fixture server during development.
GC_API_BASE=

# Extra headers merged into every upstream GameChanger request, as a JSON object, e.g.
# {"x-aws-waf-token":"..."}. The escape hatch for when GameChanger's WAF starts challenging the
# server; see docs/verifying-the-gamechanger-pull.md. Applied last, so it can override the
# origin/referer/user-agent the function otherwise sends.
GC_EXTRA_HEADERS=

# Bearer token for the GameChanger API, if one is ever required. Unset, requests go unauthenticated,
# which is what the public schedule endpoints expect.
GC_TOKEN=

# --- CI only -------------------------------------------------------------------------------------
#
# VERIFY_GC_PROXY is an optional GitHub Actions repository variable naming a different Firebase
# proxy for the weekly check. Unset, it checks this project's gcTeam function.
